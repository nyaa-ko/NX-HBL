#---------------------------------------------------------------------------------
.SUFFIXES:
#---------------------------------------------------------------------------------

ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitpro")
endif

TOPDIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
include $(DEVKITPRO)/libnx/switch_rules

#---------------------------------------------------------------------------------
TARGET      := homebrew_launcher
BUILD       := build
SOURCES     := common/ nx_main/
DATA        := data
INCLUDES    := include
ROMFS       := romfs

DIST_PATH   := $(TARGET)_v$(APP_VERSION)

APP_AUTHOR  := Dimok / switchbrew
APP_TITLE   := Homebrew Launcher

#---------------------------------------------------------------------------------
# options for code generation
#---------------------------------------------------------------------------------
ARCH := -march=armv8-a -mtune=cortex-a57 -mtp=soft -fPIE

CFLAGS := -g -Wall -O2 -ffunction-sections \
          $(ARCH) $(DEFINES) `$(PREFIX)pkg-config --cflags libconfig libturbojpeg freetype2 physfs`

CFLAGS += $(INCLUDE) -D__SWITCH__ -DVERSION=\"v$(APP_VERSION)\"

CXXFLAGS := $(CFLAGS) -fno-rtti -fno-exceptions

ASFLAGS := -g $(ARCH)

LDFLAGS = -specs=$(DEVKITPRO)/libnx/switch.specs -g $(ARCH) \
          -Wl,-Map,$(notdir $*.map)

LIBS := -ldeko3d `$(PREFIX)pkg-config --libs libconfig libturbojpeg freetype2 physfs`

LIBDIRS := $(PORTLIBS) $(LIBNX)

#---------------------------------------------------------------------------------
# Build source lists
#---------------------------------------------------------------------------------
ifneq ($(BUILD),$(notdir $(CURDIR)))

export OUTPUT := $(CURDIR)/$(TARGET)
export TOPDIR := $(CURDIR)

# IMPORTANT:
# Only builtin.c is taken from nx_main/loaders/.
# Do NOT add nx_main/loaders/ to SOURCES because it also contains
# PC/SDL implementations which must not be built for Switch.
export VPATH := $(foreach dir,$(SOURCES),$(TOPDIR)/$(dir)) \
                $(TOPDIR)/nx_main/loaders \
                $(foreach dir,$(DATA),$(TOPDIR)/$(dir))

export DEPSDIR := $(CURDIR)/$(BUILD)

# Normal Switch/common sources
CFILES := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))

# Add ONLY the builtin loader
CFILES += builtin.c

CPPFILES := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
SFILES := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
BINFILES := $(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.*)))

#---------------------------------------------------------------------------------
# use CXX for linking C++ projects, CC for standard C
#---------------------------------------------------------------------------------
ifeq ($(strip $(CPPFILES)),)
export LD := $(CC)
else
export LD := $(CXX)
endif

export OFILES_BIN := $(addsuffix .o,$(BINFILES))
export OFILES_SRC := $(CPPFILES:.cpp=.o) \
                     $(CFILES:.c=.o) \
                     $(SFILES:.s=.o)

export OFILES := $(OFILES_BIN) $(OFILES_SRC)

export HFILES_BIN := $(addsuffix .h,$(subst .,_,$(BINFILES)))

export INCLUDE := $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
                  $(foreach dir,$(LIBDIRS),-I$(dir)/include) \
                  -I$(CURDIR)/$(BUILD)

export LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

#---------------------------------------------------------------------------------
# JSON
#---------------------------------------------------------------------------------
ifeq ($(strip $(CONFIG_JSON)),)
jsons := $(wildcard *.json)

ifneq (,$(findstring $(TARGET).json,$(jsons)))
export APP_JSON := $(TOPDIR)/$(TARGET).json
else
ifneq (,$(findstring config.json,$(jsons)))
export APP_JSON := $(TOPDIR)/config.json
endif
endif

else
export APP_JSON := $(TOPDIR)/$(CONFIG_JSON)
endif

#---------------------------------------------------------------------------------
# ICON
#---------------------------------------------------------------------------------
ifeq ($(strip $(ICON)),)
icons := $(wildcard *.jpg)

ifneq (,$(findstring $(TARGET).jpg,$(icons)))
export APP_ICON := $(TOPDIR)/$(TARGET).jpg
else
ifneq (,$(findstring icon.jpg,$(icons)))
export APP_ICON := $(TOPDIR)/icon.jpg
endif
endif

else
export APP_ICON := $(TOPDIR)/$(ICON)
endif

ifeq ($(strip $(NO_ICON)),)
export NROFLAGS += --icon=$(APP_ICON)
endif

#---------------------------------------------------------------------------------
# NACP
#---------------------------------------------------------------------------------
ifeq ($(strip $(NO_NACP)),)
export NROFLAGS += --nacp=$(CURDIR)/$(TARGET).nacp
endif

ifneq ($(APP_TITLEID),)
export NACPFLAGS += --titleid=$(APP_TITLEID)
endif

#---------------------------------------------------------------------------------
# ROMFS
#---------------------------------------------------------------------------------
ifneq ($(ROMFS),)
export NROFLAGS += --romfsdir=$(CURDIR)/$(ROMFS)
endif

#---------------------------------------------------------------------------------
.PHONY: $(BUILD) clean all dist-bin

all: $(BUILD)

$(BUILD):
	@[ -d $@ ] || mkdir -p $@
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile.nx

#---------------------------------------------------------------------------------
clean:
	@echo clean ...
ifeq ($(strip $(APP_JSON)),)
	@rm -fr $(BUILD) $(TARGET).nro $(TARGET).nacp $(TARGET).elf
else
	@rm -fr $(BUILD) $(TARGET).nsp $(TARGET).nso $(TARGET).npdm $(TARGET).elf
endif

#---------------------------------------------------------------------------------
dist-bin: all
	@mkdir -p $(DIST_PATH)
	@cp $(OUTPUT).nro $(DIST_PATH)/hbmenu.nro
	@zip -rj $(DIST_PATH).zip $(DIST_PATH)

#---------------------------------------------------------------------------------
else

.PHONY: all

DEPENDS := $(OFILES:.o=.d)

#---------------------------------------------------------------------------------
# main targets
#---------------------------------------------------------------------------------
ifeq ($(strip $(APP_JSON)),)

all: $(OUTPUT).nro

ifeq ($(strip $(NO_NACP)),)
$(OUTPUT).nro: $(OUTPUT).elf $(OUTPUT).nacp
else
$(OUTPUT).nro: $(OUTPUT).elf
endif

else

all: $(OUTPUT).nsp

$(OUTPUT).nsp: $(OUTPUT).nso $(OUTPUT).npdm

$(OUTPUT).nso: $(OUTPUT).elf

endif

menu.o: $(TOPDIR)/Makefile

$(OUTPUT).elf: $(OFILES)

$(OFILES_SRC): $(HFILES_BIN)

#---------------------------------------------------------------------------------
# binary data
#---------------------------------------------------------------------------------
%.bin.o %_bin.h: %.bin
	@echo $(notdir $<)
	@$(bin2o)

-include $(DEPENDS)

#---------------------------------------------------------------------------------
endif
